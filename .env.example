# Copy to .env and fill in. Never commit .env.

# --- Providers ---
# Etherscan V2 (one key for all EVM chains; chainid selects chain). REQUIRED.
# Free: 3 req/s, 100k calls/day, 1k records/request. https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# Blockchair (BTC curation/dataset dumps only, ~1k calls/day free). Optional — works keyless at low volume.
BLOCKCHAIR_API_KEY=
# TronGrid (Tron is deferred — §21). Optional.
TRONGRID_API_KEY=
# BTC live path needs no key: mempool.space primary, Blockstream Esplora failover.
MEMPOOL_BASE_URL=https://mempool.space/api
ESPLORA_BASE_URL=https://blockstream.info/api

# Hostnames below are for host-side scripts; compose overrides them inside containers.
# --- Postgres (system of record) ---
POSTGRES_DB=vasp
POSTGRES_USER=vasp
POSTGRES_PASSWORD=vasp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j (derived graph index) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# --- Redis (Celery broker/backend, cache, rate-limit buckets) ---
REDIS_URL=redis://localhost:6379/0
